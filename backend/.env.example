# ============================================
# BACKEND .env — ĐIỀN THÔNG TIN THỰC TẾ VÀO ĐÂY
# ============================================

# MongoDB Atlas — thay bằng URI thực của bạn
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/database?retryWrites=true&w=majority

# JWT Secrets
JWT_SECRET=tttn_jwt_secret_change_this_in_production_2024
JWT_REFRESH_SECRET=tttn_refresh_secret_change_this_in_production_2024
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# OpenAI (nếu dùng AI service)
OPENAI_API_KEY=your_openai_api_key_here

# AI Service
AI_SERVICE_URL=http://localhost:8000

# Server
NODE_ENV=development
PORT=5000